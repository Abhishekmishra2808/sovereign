# Copy to .env and fill in values. Never commit .env.

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
# Must match the deployment NAME in Azure Portal (not necessarily the model name)
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: true to use /openai/v1/chat/completions
# AZURE_OPENAI_USE_V1=true

# Render coordinator (generate a random key; never commit real keys)
SOVEREIGN_ADMIN_TOKEN=
SOVEREIGN_DB=data/workspace.db
# Vercel coordinator: persistent Postgres URL (use instead of SOVEREIGN_DB)
DATABASE_URL=
# Outbound worker (or enter its key at the prompt)
SOVEREIGN_SERVER_URL=
SOVEREIGN_WORKER_TOKEN=
SOVEREIGN_BIN=
# Auto routing stays on CPU until repeated whole-solver CUDA speedup is shown.
# Manual CUDA selection works without this experimental size-based override.
# SOVEREIGN_GPU_AUTO_ENABLED=1
